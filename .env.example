# Local development only. Never put real customer data in this build.
REPLYPILOT_LOCAL_DEV=1
AI_PROVIDER=mock
# Configure explicitly after checking current model eligibility and data terms.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_SYNTHETIC_DATA_ONLY=true
GEMINI_MAX_CALLS_PER_DAY=30
# Local admin must be provisioned using npm run admin -- email@example.test
